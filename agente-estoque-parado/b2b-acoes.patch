+/* Visual gogroup: azul protagonista, lima para o que pede ação, off-white para leitura */
+:root {
+  --azul: #2659A5; --lima: #D7D900; --off: #F5F0E8; --branco: #FFFFFF;
+  --tinta: #1F2A44; --suave: #5A6680; --linha: #D9D3C7; --verm: #E5381A; --laranja: #F8AE13;
+  --fonte: "Poppins", Arial, sans-serif;
+}
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--azul); color: var(--tinta); font: 15px/1.5 var(--fonte); padding: 0 16px; padding-block: 20px 40px; }
+.wrap { max-width: 1240px; margin: 0 auto; display: grid; gap: 16px; }
+header { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; color: var(--branco); }
+header h1 { margin: 0 auto 0 0; font-size: 1.5rem; font-weight: 700; }
+header h1 small { display: block; font-size: .85rem; font-weight: 400; opacity: .85; }
+.chip { font-size: .8rem; padding: 3px 10px; border-radius: 999px; background: rgba(255,255,255,.15); }
+.chip.on { background: var(--lima); color: var(--azul); font-weight: 600; }
+button { font: 600 .9rem var(--fonte); border-radius: 999px; padding: 8px 16px; cursor: pointer; border: 2px solid var(--azul); background: var(--branco); color: var(--azul); }
+button:hover { background: var(--off); }
+button.go { background: var(--lima); border-color: var(--lima); color: var(--azul); font-size: 1rem; padding: 10px 22px; }
+button.go:hover { filter: brightness(.95); }
+button.prim { background: var(--azul); color: var(--branco); }
+button:disabled { opacity: .5; cursor: default; }
+:focus-visible { outline: 3px solid var(--lima); outline-offset: 2px; }
+.fonte { display: flex; align-items: center; gap: 8px; font-size: .85rem; }
+.fonte select { font: 600 .9rem var(--fonte); border-radius: 999px; border: 0; padding: 8px 12px; color: var(--azul); background: var(--branco); }
+.timer { font-variant-numeric: tabular-nums; font-weight: 700; background: var(--branco); color: var(--azul); border-radius: 999px; padding: 8px 14px; }
+main { display: grid; grid-template-columns: 360px 1fr; gap: 16px; align-items: start; }
+.panel { background: var(--off); border-radius: 22px; padding: 20px; min-width: 0; }
+.panel h2 { margin: 0 0 4px; font-size: 1.05rem; color: var(--azul); }
+.panel p.help { margin: 0 0 10px; color: var(--suave); font-size: .85rem; }
+.list { display: grid; gap: 8px; margin-bottom: 18px; }
+.item { text-align: left; border-radius: 14px; border: 2px solid transparent; background: var(--branco); padding: 10px 12px; display: grid; gap: 2px; font-weight: 500; color: var(--tinta); }
+.item b { font-weight: 600; }
+.item .why { font-size: .82rem; color: var(--suave); font-weight: 400; }
+.item.risco .why { color: var(--verm); }
+.item[aria-current="true"] { border-color: var(--azul); }
+.item:hover { background: var(--branco); border-color: var(--linha); }
+.empty { color: var(--suave); font-size: .9rem; }
+.head-prod { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; margin-bottom: 4px; }
+.head-prod h2 { font-size: 1.35rem; }
+.tag { font-size: .78rem; font-weight: 600; border-radius: 999px; padding: 2px 10px; background: var(--azul); color: var(--branco); }
+.tag.risco { background: var(--laranja); color: var(--tinta); }
+.tag.real { background: var(--lima); color: var(--azul); }
+.facts { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--suave); font-size: .88rem; margin-bottom: 14px; }
+.facts b { color: var(--tinta); }
+.msgs { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
+.msg { background: var(--branco); border-radius: 16px; padding: 14px 16px; display: grid; gap: 6px; align-content: start; min-width: 0; }
+.msg .top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+.msg h3 { margin: 0; font-size: 1rem; color: var(--azul); }
+.msg label { font-size: .8rem; color: var(--suave); display: flex; gap: 6px; align-items: center; }
+.msg dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 2px 10px; font-size: .88rem; }
+.msg dt { font-weight: 600; }
+.msg dd { margin: 0; min-width: 0; }
+.msg pre { margin: 4px 0 0; white-space: pre-wrap; word-break: break-word; font: .82rem/1.45 var(--fonte); background: var(--off); border-radius: 10px; padding: 10px; max-height: 220px; overflow: auto; }
+.msg .acts, .msg .vends { display: flex; flex-wrap: wrap; gap: 8px; }
+.msg .vends button { padding: 5px 12px; font-size: .78rem; background: var(--off); }
+.resumo-b2b { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0; }
+.resumo-b2b span { font-size: .76rem; font-weight: 600; background: var(--off); border-radius: 999px; padding: 3px 10px; color: var(--azul); }
+.vend-h { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 10px 0 4px; font-size: .88rem; color: var(--azul); }
+.vend-h button { padding: 3px 10px; font-size: .74rem; background: var(--off); }
+.msg.b2b { grid-column: 1 / -1; }
+.clis { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 10px; }
+.cli { border: 1.5px solid var(--linha); border-radius: 14px; padding: 10px 12px; display: grid; gap: 6px; background: var(--branco); }
+.cli p { margin: 0; font-size: .84rem; }
+.cli .top-c { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
+.cli .top-c b { font-size: .95rem; }
+.cli .meta { font-size: .78rem; color: var(--suave); }
+.pill { font-size: .68rem; font-weight: 700; border-radius: 999px; padding: 2px 9px; background: var(--azul); color: var(--branco); }
+.pill.incluir { background: var(--lima); color: var(--azul); }
+.cli .aviso { color: var(--verm); }
+.cli .ct { background: var(--off); border-radius: 8px; padding: 6px 8px; }
+.cli .ct.sem { color: var(--verm); }
+.cli textarea { width: 100%; font: .82rem/1.4 var(--fonte); border: 1.5px solid var(--linha); border-radius: 10px; padding: 8px; resize: vertical; background: var(--off); color: var(--tinta); }
+.cli details summary { font-size: .8rem; }
+.btnlink { font: 600 .8rem var(--fonte); border-radius: 999px; padding: 5px 12px; background: var(--lima); color: var(--azul); text-decoration: none; border: 2px solid var(--lima); }
+details.txt { font-size: .8rem; }
+.exec { background: color-mix(in srgb, var(--lima) 22%, var(--branco)); border-radius: 10px; padding: 8px 10px; font-size: .82rem; }
+.exec .canal { font-size: .76rem; font-weight: 600; color: var(--azul); }
+.exec ol { margin: 4px 0 0; padding-left: 1.2em; display: grid; gap: 2px; }
+.msg .acts button { padding: 5px 12px; font-size: .8rem; }
+.bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 14px 0 0; }
+.note { font-size: .85rem; color: var(--suave); }
+.note.err { color: var(--verm); }
+.note.ok { color: var(--azul); font-weight: 600; }
+details { background: var(--off); border-radius: 22px; padding: 14px 20px; }
+summary { cursor: pointer; font-weight: 600; color: var(--azul); }
+form { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px 14px; margin-top: 12px; }
+form label { display: grid; gap: 4px; font-size: .82rem; color: var(--suave); }
+form input, form select { font: .95rem var(--fonte); padding: 8px 10px; border-radius: 10px; border: 1.5px solid var(--linha); background: var(--branco); color: var(--tinta); }
+form .full { grid-column: 1 / -1; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
+@media (max-width: 860px) { main { grid-template-columns: 1fr; } }
+</style>
+</head>
+<body>
+<div class="wrap">
+  <header>
+    <h1>Agente de Estoque Parado <small>Acha o que parou ou está parando e entrega a ação pronta: recompra no B2B e influenciadores no B2C</small></h1>
+    <span class="chip" id="chipChat">Chat: não configurado</span>
+    <span class="chip" id="chipIA">IA: textos do agente</span>
+    <span class="timer" id="timer" aria-live="polite">0,0 s</span>
+    <label class="fonte"><span>Base</span>
+      <select id="fonte">
+        <option value="b2c">Gobeaute B2C real (planilha 14/10)</option>
+        <option value="gobeaute" selected>Gobeaute B2B real (Torre)</option>
+      </select>
+    </label>
+    <button class="go" id="rodar">Rodar agente</button>
+  </header>
+
+  <main>
+    <section class="panel" aria-labelledby="t-radar">
+      <h2 id="t-radar">Radar</h2>
+      <p class="help">Clique em um produto para ver a ação de cada time.</p>
+      <div id="radar"><p class="empty">Clique em "Rodar agente" para começar.</p></div>
+    </section>
+
+    <section class="panel" id="detalhe" aria-live="polite">
+      <p class="empty">As ações por time aparecem aqui.</p>
+    </section>
+  </main>
+
+  <details id="realBox">
+    <summary>Testar com um produto real</summary>
+    <p class="note">Use números passados por Growth ou Supply. O produto entra no radar com a etiqueta "real" e fica salvo para o time.</p>
+    <form id="formReal">
+      <label>Produto<input id="r-produto" required placeholder="Copo Vibe Preto"></label>
+      <label>Categoria
+        <select id="r-categoria">
+          <option>Copos e garrafas</option><option>Capinhas</option><option>Bolsas</option><option>Acessórios</option><option>Pet</option>
+        </select>
+      </label>
+      <label>Estoque (unidades)<input id="r-estoque_un" inputmode="decimal" required></label>
+      <label>Custo por unidade (R$)<input id="r-custo_unit_brl" inputmode="decimal" required></label>
+      <label>Preço cheio (R$)<input id="r-preco_cheio_brl" inputmode="decimal" required></label>
+      <label>Venda últimos 15 dias (un)<input id="r-venda_15d_un" inputmode="decimal" required></label>
+      <label>Venda 15 dias anteriores (un)<input id="r-venda_15d_anteriores_un" inputmode="decimal" required></label>
+      <div class="full"><button class="prim" type="submit">Analisar produto real</button><span class="note" id="realMsg"></span></div>
+    </form>
+  </details>
+</div>
+
+<script>
+(() => {
+  const $ = (s) => document.querySelector(s);
+  const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
+  const brl = (v) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
+  let dados = null, atual = null, status = { webhook: false, ia: false }, t0 = 0, tick = null;
+
+  function iniciarTimer() { t0 = performance.now(); clearInterval(tick); tick = setInterval(() => { $("#timer").textContent = ((performance.now() - t0) / 1000).toFixed(1).replace(".", ",") + " s"; }, 100); }
+  function pararTimer(rotulo) { clearInterval(tick); const s = ((performance.now() - t0) / 1000).toFixed(1).replace(".", ","); $("#timer").textContent = rotulo + " " + s + " s"; }
+
+  async function api(path, opts) {
+    const r = await fetch(path, opts);
+    const b = await r.json().catch(() => ({ erro: "Resposta inválida do servidor" }));
+    if (!r.ok) throw new Error(b.erro || "Erro " + r.status);
+    return b;
+  }
+
+  async function carregarStatus() {
+    try {
+      status = await api("/api/status");
+      $("#chipChat").textContent = status.webhook ? "Chat: conectado" : "Chat: não configurado";
+      $("#chipChat").classList.toggle("on", status.webhook);
+      $("#chipIA").textContent = status.ia ? "IA: AI Proxy" : "IA: textos do agente";
+      $("#chipIA").classList.toggle("on", status.ia);
+    } catch (e) {}
+  }
+
+  function item(a) {
+    const real = a.status === "real" ? ' <span class="tag real">real</span>' : "";
+    return `<button class="item ${a.classe === "em_risco" ? "risco" : ""}" data-sku="${esc(a.sku)}"><b>${esc(a.produto)}${real}</b><span class="why">${esc(a.motivo)}</span></button>`;
+  }
+
+  function renderRadar() {
+    const p = dados.parados, r = dados.emRisco;
+    $("#radar").innerHTML =
+      `<p class="help"><b>${dados.fonte === "ficticia" ? "Base fictícia" : "Dados reais"}.</b> ${esc(dados.info)}</p>` +
+      (dados.reais.length ? `<h2>Produto real em teste (${dados.reais.length})</h2><p class="help">Números passados pelo time.</p><div class="list">${dados.reais.map(item).join("")}</div>` : "") +
+      `<h2>Entrando em slow moving (${r.length})</h2><p class="help">Critério em teste, ainda não é regra da empresa: estoque entre 90 e 120 dias, ou venda caindo 30% ou mais com estoque acima de 60 dias.</p>` +
+      `<div class="list">${r.map(item).join("") || '<p class="empty">Nenhum agora.</p>'}</div>` +
+      `<h2>Slow moving (${p.length})</h2><p class="help">Estoque para mais de 120 dias no ritmo dos últimos 15 dias. Do maior valor em estoque para o menor.</p>` +
+      `<div class="list">${p.map(item).join("")}</div>` +
+      (dados.saudaveis.length ? `<p class="help">Saudáveis, sem ação: ${esc(dados.saudaveis.join(", "))}</p>` : "");
+    document.querySelectorAll(".item").forEach((b) => b.addEventListener("click", () => abrir(b.dataset.sku)));
+  }
+
+  function todos() { return [...dados.reais, ...dados.emRisco, ...dados.parados]; }
+
+  function abrir(sku) {
+    atual = todos().find((a) => a.sku === sku);
+    if (!atual) return;
+    document.querySelectorAll(".item").forEach((b) => b.setAttribute("aria-current", String(b.dataset.sku === sku)));
+    const a = atual;
+    const tag = a.status === "real" ? `<span class="tag real">produto real, ${a.classe === "parado" ? "slow moving" : a.classe === "em_risco" ? "entrando em slow moving" : "saudável"}</span>` :a.classe === "em_risco" ? '<span class="tag risco">entrando em slow moving</span>' : '<span class="tag">slow moving</span>';
+    $("#detalhe").innerHTML = `
+      <div class="head-prod"><h2>${esc(a.produto)}</h2>${tag}</div>
+      <div class="facts">
+        <span>Por quê: <b>${esc(a.motivo)}</b></span>
+        <span>Oferta: <b>${esc(a.oferta.descricao)}</b></span>
+        <span>Preço mínimo com margem: <b>${brl(a.precoMinimo)}</b></span>
+      </div>
+      <div class="msgs">${a.mensagens.map((m, i) => `
+        <article class="msg${m.acoes ? " b2b" : ""}">
+          <div class="top"><h3>${esc(m.time)}</h3><label><input type="checkbox" class="sel" value="${esc(m.time)}" checked> enviar</label></div>
+          <dl><dt>O que fazer</dt><dd>${esc(m.oQueFazer)}</dd><dt>Por quê</dt><dd>${esc(m.porque)}</dd><dt>Até quando</dt><dd>${esc(m.ateQuando)}</dd></dl>
+          ${m.acoes ? cartoes(m, i) + `<details class="txt"><summary>Texto completo para copiar</summary><pre id="pronto-${i}">${esc(m.pronto)}</pre></details>` : `<pre id="pronto-${i}">${esc(m.pronto)}</pre>`}
+          <div class="exec">
+            <b>Como executar agora</b> <span class="canal">${esc(m.executar.canal)}</span>
+            <ol>${m.executar.passos.map((p) => `<li>${esc(p)}</li>`).join("")}</ol>
+          </div>
+          ${m.porVendedor ? `<div class="vends">${m.porVendedor.map((v, j) => `<button data-vend="${i}:${j}">Copiar para ${esc(v.vendedor)} (${v.clientes} cliente${v.clientes > 1 ? "s" : ""})</button>`).join("")}</div>` : ""}
+          <div class="acts"><button data-copy="${i}">Copiar</button>${m.porVendedor ? `<button data-csv="${i}">Baixar lista (CSV)</button>` : ""}</div>
+        </article>`).join("")}
+      </div>
+      <div class="bar">
+        <button class="prim" id="enviar">Enviar para os times marcados</button>
+        <button id="ia">Reescrever textos de Growth com IA</button>
+        ${a.status === "real" ? '<button id="remover">Remover produto real</button>' : ""}
+        <span class="note" id="envioMsg"></span>
+      </div>`;
+    document.querySelectorAll("[data-copy]").forEach((b) => b.addEventListener("click", () => copiar(b)));
+    document.querySelectorAll("[data-vend]").forEach((b) => b.addEventListener("click", () => {
+      const [i, j] = b.dataset.vend.split(":").map(Number);
+      copiarTexto(b, atual.mensagens[i].porVendedor[j].texto);
+    }));
+    document.querySelectorAll("[data-csv]").forEach((b) => b.addEventListener("click", () => baixarCsv(+b.dataset.csv)));
+    document.querySelectorAll("[data-cc]").forEach((b) => b.addEventListener("click", () => {
+      const [i, j, t] = b.dataset.cc.split(":"); const x = atual.mensagens[+i].acoes[+j];
+      copiarTexto(b, t === "wa" ? x.whatsapp : `Assunto: ${x.emailAssunto}\n\n${x.emailCorpo}`);
+    }));
+    document.querySelectorAll(".cli textarea").forEach((t) => { t.style.height = "auto"; t.style.height = t.scrollHeight + 4 + "px"; });
+    a.mensagens.forEach((m, i) => { if (m.acoes) carregarContatos(i); });
+    $("#enviar").addEventListener("click", enviar);
+    $("#ia").addEventListener("click", reescrever);
+    const rm = $("#remover"); if (rm) rm.addEventListener("click", remover);
+  }
+
+
+  // ---- B2B: um cartão por cliente, com contato e mensagens prontas ----
+  const num0 = (v) => Math.round(v).toLocaleString("pt-BR");
+  function cartoes(m, i) {
+    const porV = {};
+    m.acoes.forEach((x, j) => { (porV[x.vendedor] ||= []).push([x, j]); });
+    const reat = m.acoes.filter((x) => x.tipo === "reativar").length, inc = m.acoes.length - reat;
+    const total = m.acoes.reduce((t, x) => t + x.valorPedido, 0), un = m.acoes.reduce((t, x) => t + x.quantidade, 0);
+    return `<div class="resumo-b2b"><span>${m.acoes.length} cliente${m.acoes.length > 1 ? "s" : ""}</span><span>${reat} reativar</span><span>${inc} incluir no próximo pedido</span><span>${num0(un)} un</span><span>${brl(total)}</span><span>validade ${esc(m.acoes[0].validade)}</span></div>
+      <div class="note" id="ctResumo-${i}">Buscando contatos no Data Mart...</div>` +
+      Object.entries(porV).map(([vend, lista]) => {
+        const jv = m.porVendedor.findIndex((v) => v.vendedor === vend);
+        return `<div class="vend-h"><b>${esc(vend)}</b> · ${lista.length} cliente${lista.length > 1 ? "s" : ""}<button data-vend="${i}:${jv}">Copiar tudo de ${esc(vend.split(" ")[0])}</button></div>` +
+          `<div class="clis">` + lista.map(([x, j]) => `<div class="cli" id="cli-${i}-${j}">
+            <div class="top-c"><span class="pill ${x.tipo}">${x.tipo === "reativar" ? "REATIVAR" : "INCLUIR NO PRÓXIMO PEDIDO"}</span><b>${esc(x.cliente)}</b><span class="meta">${esc(x.cidade)}/${esc(x.uf)}</span></div>
+            <p>${esc(x.situacao)}</p>
+            <p><b>Oferta:</b> ${num0(x.quantidade)} un a ${brl(x.precoUn)} = ${brl(x.valorPedido)}. ${esc(x.condicao)}. Teste ${esc(x.braco)}, tabela ${esc(x.faixa)}. Validade ${esc(x.validade)}.</p>
+            ${x.aviso ? `<p class="aviso">${esc(x.aviso)}</p>` : ""}
+            <p class="ct" id="ct-${i}-${j}"><b>Contato:</b> <span>buscando...</span></p>
+            <b style="font-size:.8rem">WhatsApp pronto</b>
+            <textarea readonly rows="5" id="wa-txt-${i}-${j}">${esc(x.whatsapp)}</textarea>
+            <div class="acts"><button data-cc="${i}:${j}:wa">Copiar mensagem</button><a class="btnlink" id="wa-${i}-${j}" target="_blank" rel="noopener" hidden>Abrir no WhatsApp</a></div>
+            <details><summary>E-mail pronto</summary><p><b>Assunto:</b> ${esc(x.emailAssunto)}</p><pre>${esc(x.emailCorpo)}</pre>
+              <div class="acts"><button data-cc="${i}:${j}:em">Copiar e-mail</button><a class="btnlink" id="mail-${i}-${j}" hidden>Abrir no e-mail</a></div></details>
+          </div>`).join("") + `</div>`;
+      }).join("");
+  }
+
+  function pintarContato(i, j, c, motivo) {
+    const el = $(`#ct-${i}-${j}`); if (!el) return;
+    const x = atual.mensagens[i].acoes[j];
+    x.contato = c || null;
+    if (c) {
+      el.className = "ct";
+      el.innerHTML = `<b>Contato:</b> ${esc([c.telefone, c.email].filter(Boolean).join(" · "))} <span class="meta">(${esc(c.fonte)}; confirme antes de enviar)</span>${c.aviso ? ` <span class="meta">Atenção: ${esc(c.aviso)}.</span>` : ""}`;
+      const d = (c.telefone || "").replace(/\D/g, "");
+      const wa = d.length === 10 || d.length === 11 ? "55" + d : d.length >= 12 && d.startsWith("55") ? d : "";
+      const a = $(`#wa-${i}-${j}`);
+      if (wa) { a.href = `https://wa.me/${wa}?text=${encodeURIComponent(x.whatsapp)}`; a.hidden = false; }
+      const m = $(`#mail-${i}-${j}`);
+      if (c.email) { m.href = `mailto:${c.email}?subject=${encodeURIComponent(x.emailAssunto)}&body=${encodeURIComponent(x.emailCorpo)}`; m.hidden = false; }
+    } else {
+      el.className = "ct sem";
+      el.innerHTML = `<b>Contato:</b> sem contato na base do agente (${esc(motivo || "não consultado")}). Abra o cliente na Torre, na conta de ${esc(x.vendedor)}.`;
+    }
